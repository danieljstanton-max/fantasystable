# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# The Racing API (HTTP Basic pair from your dashboard)
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Postgres. Neon connection string, e.g.
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Any random string. Guards /api/revalidate so only your ingest job can call it.
REVALIDATE_SECRET=

# Used for canonical URLs and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
